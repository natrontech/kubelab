{
  "name": "ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:backend": "cd ../kubelab-backend && air",
    "backend": "cd ../kubelab-backend && ./pocketbase serve --publicDir=../kubelab-ui/build",
    "build": "vite build",
    "build:backend": "cd ../kubelab-backend && go build",
    "typegen": "pocketbase-typegen --db ../kubelab-backend/pb_data/data.db --out ./src/lib/pocketbase/generated-types.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@huntabyte/primitives": "^0.0.19",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/kit": "^2.48.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@tailwindcss/typography": "^0.5.13",
    "@types/marked": "^5.0.0",
    "@types/node": "^24.9.2",
    "@types/prismjs": "^1.26.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "autoprefixer": "^10.4.13",
    "bits-ui": "^2.14.2",
    "clsx": "^2.1.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.13.0",
    "globals": "^16.5.0",
    "mdsvex": "^0.11.0",
    "pocketbase": "^0.26.3",
    "postcss": "^8.4.38",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "^5.43.2",
    "svelte-check": "^4.3.3",
    "svelte-preprocess": "^6.0.3",
    "svelte-splitpanes": "^8.0.9",
    "tailwind-merge": "^3.3.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwind-variants": "^3.1.1",
    "tailwindcss": "^3.4.18",
    "tslib": "^2.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^7.1.12"
  },
  "type": "module",
  "dependencies": {
    "@floating-ui/dom": "^1.2.8",
    "@internationalized/date": "^3.10.0",
    "@picocss/pico": "^2.0.6",
    "@sveltejs/adapter-node": "^5.4.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@webcontainer/api": "^1.1.9",
    "chart.js": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "lucide-svelte": "^0.552.0",
    "marked": "^16.4.1",
    "pocketbase-typegen": "^1.2.1",
    "prismjs": "^1.29.0",
    "svelte-confetti": "^2.3.2",
    "svelte-french-toast": "^1.2.0",
    "svelte-icons-pack": "^3.1.3",
    "svelte-local-storage-store": "^0.6.4",
    "svelte-markdown": "^0.4.1",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  }
}
