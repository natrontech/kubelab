{
  "name": "ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:backend": "cd ../kubelab-backend && modd",
    "backend": "cd ../kubelab-backend && ./pocketbase serve --publicDir=../kubelab-ui/build",
    "build": "vite build",
    "build:backend": "cd ../kubelab-backend && go build",
    "typegen": "pocketbase-typegen --db ../kubelab-backend/pb_data/data.db --out ./src/lib/pocketbase/generated-types.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "svelte-kit sync",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "daisyui": "^5.8.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "flowbite": "^4.0.2",
    "flowbite-svelte": "^1.33.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "pocketbase": "^0.29.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-splitpanes": "^8.0.12",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "dependencies": {
    "@lucide/svelte": "^1.79.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pocketbase-typegen": "^1.6.0",
    "prismjs": "^1.30.0",
    "svelte-confetti": "^2.3.2",
    "svelte-exmarkdown": "^5.0.2",
    "svelte-local-storage-store": "^0.6.4",
    "svelte-sonner": "^1.2.3"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24"
  }
}
