{
  "name": "ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "dev:backend": "cd ../kubelab-backend && modd",
    "backend": "cd ../kubelab-backend && ./pocketbase serve --publicDir=../kubelab-ui/build",
    "build": "vite build",
    "build:backend": "cd ../kubelab-backend && go build",
    "typegen": "pocketbase-typegen --db ../kubelab-backend/pb_data/data.db --out ./src/lib/pocketbase/generated-types.ts",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "svelte-kit sync",
    "test": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.11",
    "@sveltejs/kit": "^2.70.4",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "daisyui": "^4.12.24",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "flowbite": "^2.5.2",
    "flowbite-svelte": "^0.48.6",
    "globals": "^17.14.0",
    "pocketbase": "~0.21.5",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^3.5.2",
    "svelte": "^4.2.20",
    "svelte-check": "^4.7.8",
    "svelte-splitpanes": "8.0.9",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^5.4.21",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "@playwright/test": "^1.62.1"
  },
  "type": "module",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "pocketbase-typegen": "^1.6.0",
    "prismjs": "^1.30.0",
    "svelte-confetti": "^1.4.0",
    "svelte-local-storage-store": "^0.6.4",
    "lucide-svelte": "^1.0.1",
    "svelte-markdown": "^0.4.1",
    "svelte-french-toast": "^1.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
